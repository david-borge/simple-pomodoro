{
  "name": "simple-pomodoro",
  "description": "Simple Pomodoro",
  "version": "0.0.1",
  "author": "David Borge",
  "homepage": "https://simple-pomodoro.com/",
  "scripts": {
    "ionic-serve:simple-pomodoro": "ionic serve --project=simple-pomodoro",
    "ionic-serve:prototype-3": "ionic serve --project=prototype-3",
    "ionic-serve:prototype-2": "ionic serve --project=prototype-2",
    "ionic-serve:prototype-1": "ionic serve --project=prototype-1",
    "capacitor:android:live:real-device:from-windows": "node ./scripts/capacitor-android-live-from-windows.js",
    "capacitor:android:live:real-device:from-macos": "node ./scripts/capacitor-android-live-from-macos.js",
    "capacitor:android:live:emulator:simple-pomodoro": "ionic capacitor run android --livereload --external --project=simple-pomodoro",
    "capacitor:android:live:emulator:prototype-3": "ionic capacitor run android --livereload --external --project=prototype-3",
    "capacitor:android:live:emulator:prototype-2": "ionic capacitor run android --livereload --external --project=prototype-2",
    "capacitor:android:live:emulator:prototype-1": "ionic capacitor run android --livereload --external --project=prototype-1",
    "capacitor:android:build:simple-pomodoro": "ng build --project=simple-pomodoro --configuration production && npx cap sync android && ionic capacitor run android --project=simple-pomodoro",
    "capacitor:android:build:prototype-3": "ng build --project=prototype-3 --configuration production && npx cap sync android && ionic capacitor run android --project=prototype-3",
    "capacitor:android:build:prototype-2": "ng build --project=prototype-2 --configuration production && npx cap sync android && ionic capacitor run android --project=prototype-2",
    "capacitor:android:build:prototype-1": "ng build --project=prototype-1 --configuration production && npx cap sync android && ionic capacitor run android --project=prototype-1",
    "capacitor:android:open-in-android-studio:simple-pomodoro": "ionic capacitor open android --project=simple-pomodoro",
    "capacitor:android:open-in-android-studio:prototype-3": "ionic capacitor open android --project=prototype-3",
    "capacitor:android:open-in-android-studio:prototype-2": "ionic capacitor open android --project=prototype-2",
    "capacitor:android:open-in-android-studio:prototype-1": "ionic capacitor open android --project=prototype-1",
    "web:deploy:simple-pomodoro": "ng build --project=simple-pomodoro --configuration production && firebase deploy",
    "web:deploy:prototype-3": "ng build --project=prototype-3 --configuration production && firebase deploy",
    "web:deploy:prototype-2": "ng build --project=prototype-2 --configuration production && firebase deploy",
    "web:deploy:prototype-1": "ng build --project=prototype-1 --configuration production && firebase deploy",
    "format": "prettier --write .",
    "lint": "eslint . --ext .js,.ts",
    "lint:fix": "eslint . --ext .js,.ts --fix",
    "format-and-lint": "prettier --write . && eslint . --ext .js,.ts --fix",
    "ng": "ng",
    "start:simple-pomodoro": "ng serve --project=simple-pomodoro",
    "start:prototype-3": "ng serve --project=prototype-3",
    "start:prototype-2": "ng serve --project=prototype-2",
    "start:prototype-1": "ng serve --project=prototype-1",
    "build:prototype-3": "ng build --project=prototype-3",
    "build:prototype-2": "ng build --project=prototype-2",
    "build:prototype-1": "ng build --project=prototype-1",
    "watch": "ng build --watch --configuration development",
    "lint-old": "npm run eslint && npm run typecheck:e2e && npm run prettier -- --check",
    "lint-old:fix": "npm run eslint -- --fix && npm run prettier -- --write",
    "eslint": "ng lint --max-warnings 0",
    "prettier": "prettier \"**/*.{ts,html}\"",
    "typecheck:e2e": "tsc -p tsconfig.e2e.json",
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "ng test --no-watch",
    "test:unit:watch": "ng test --watch",
    "test:e2e": "playwright test"
  },
  "private": true,
  "dependencies": {
    "@angular/common": "22.2.5",
    "@angular/compiler": "22.2.5",
    "@angular/core": "22.2.5",
    "@angular/forms": "22.2.5",
    "@angular/platform-browser": "22.2.5",
    "@angular/router": "22.2.5",
    "@capacitor/android": "8.6.0",
    "@capacitor/app": "8.1.2",
    "@capacitor/core": "8.6.0",
    "@capacitor/haptics": "8.0.2",
    "@capacitor/keyboard": "8.0.6",
    "@capacitor/status-bar": "8.0.4",
    "@ionic/angular": "^9.0.0",
    "ionicons": "^8.1.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "22.2.6",
    "@angular/cli": "22.2.6",
    "@angular/compiler-cli": "22.2.5",
    "@angular/language-service": "22.2.5",
    "@capacitor/cli": "8.6.0",
    "@ionic/angular-toolkit": "^13.0.0",
    "@ionic/eslint-config": "^0.5.0",
    "@ionic/prettier-config": "^4.0.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.6",
    "angular-eslint": "22.6.0",
    "eslint": "^10.10.0",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "jsdom": "^30.1.1",
    "prettier": "^3.9.10",
    "typescript": "~6.0.0",
    "typescript-eslint": "^8.61.0",
    "vitest": "^5.1.0"
  },
  "prettier": "@ionic/prettier-config"
}
